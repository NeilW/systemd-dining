#!/bin/sh
set -e

MAILBOX="$1"

# Critical section: capture and truncate only
{
    flock 9 || exit 1
    MAILS=$(from -f "${MAILBOX}")
    : > "${MAILBOX}"
} 9< "$MAILBOX"

# Lock released; process the captured output
printf '%s\n' "${MAILS}" |
    sed 's/^<\(.*\)@.*>\t\(.*\)$/\1 "\2"/' |
    xargs -r -n 2 -- /usr/local/bin/mail-tasks |
    logger -p local0.info -t mail-tasks
