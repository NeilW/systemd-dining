#!/bin/sh
set -e

MAILBOX="$1"

# Lock the mailbox, process with 'from', then zero it
{
    flock 9 || exit 1

    # Extract sender and subject using 'from', then process
    from |
        sed 's/^<\(.*\)@.*>\t\(.*\)$/\1 "\2"/' |
        xargs -r -n 2 -- /usr/local/bin/mail-tasks |
        logger -p local0.info -t mail-tasks

    # Zero out the mailbox after processing
    : > "$MAILBOX"
} 9< "$MAILBOX"
